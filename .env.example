# RegGuard configuration
# Copy to .env and adjust. .env is git-ignored; this file is not.

# --- application -------------------------------------------------------------
APP_NAME=RegGuard
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | text

# --- model -------------------------------------------------------------------
# stub      = deterministic in-process model. No API key, no network. Default,
#             so a reviewer can clone and run the whole system immediately.
# openai    = requires OPENAI_API_KEY and an OpenAI LLM_MODEL
# anthropic = requires ANTHROPIC_API_KEY and a Claude LLM_MODEL
LLM_PROVIDER=stub
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.0        # routing must be reproducible
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- data -------------------------------------------------------------------
# dataset = anchor lookback windows to the newest transaction in the shipped
#           fixtures. Deterministic, and the right default for synthetic data:
#           "last 30 days" means the 30 days before the data ends.
# now     = anchor to wall-clock UTC. What a live source system needs.
TIME_ANCHOR=dataset

# --- retention --------------------------------------------------------------
# Investigations kept by the in-memory checkpointer before the least recently
# written is evicted. Bounds memory in a long-lived process; use a durable
# checkpointer (langgraph-checkpoint-postgres) for real deployments.
MAX_RETAINED_INVESTIGATIONS=200

# --- authentication ---------------------------------------------------------
# Off by default so the project runs out of the box. ENVIRONMENT=production
# refuses to start unless this is true: an approval must be attributable to an
# authenticated reviewer rather than to a name typed into the request body.
AUTH_ENABLED=false
# Comma-separated 'token:principal:role', role is analyst or approver.
# Real deployments authenticate against an identity provider instead.
API_TOKENS=

# --- agent guardrails --------------------------------------------------------
MAX_SUPERVISOR_STEPS=8     # ceiling on LLM routing decisions per investigation
MAX_TOOL_ITERATIONS=4      # ceiling on tool rounds inside one specialist
MAX_VISITS_PER_AGENT=2     # re-entering a specialist beyond this is a loop
GRAPH_RECURSION_LIMIT=40   # LangGraph's own backstop

# --- governance --------------------------------------------------------------
# HIGH-risk investigations pause for human authorisation before release.
# Never disable outside local experimentation.
REQUIRE_APPROVAL_FOR_HIGH_RISK=true
